BACKEND_IMAGE=ghcr.io/mavravetasyan/workout-journal-backend:latest
BACKEND_PORT=8000

POSTGRES_DB=workout_journal
POSTGRES_USER=workout_user
POSTGRES_PASSWORD=change-me-strong-password

SECRET_KEY=change-me-long-random-secret
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
STATIC_DIR=/app/static
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_LENGTH=6
LOGIN_CODE_RESEND_SECONDS=30
LOGIN_CODE_MAX_ATTEMPTS=5
DEBUG_AUTH_CODES=0
MAIL_PROVIDER=resend
MAIL_FROM=Workout Journal <login@your-domain.com>
MAIL_REPLY_TO=support@your-domain.com
APP_NAME=Workout Journal
APP_LOGIN_URL=https://app.your-domain.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
